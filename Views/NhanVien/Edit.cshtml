@model PerfumeShop.Models.NguoiDung

@{
    
    ViewData["Title"] = "Chỉnh sửa người dùng";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i> Chỉnh sửa người dùng</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" id="editForm">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ID_TK" />

                <div class="mb-3">
                    <label asp-for="HoTen" class="form-label fw-semibold"></label>
                    <input asp-for="HoTen" class="form-control" id="HoTen" data-original="@Model.HoTen" />
                    <span asp-validation-for="HoTen" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SoDienThoai" class="form-label fw-semibold"></label>
                    <input asp-for="SoDienThoai" class="form-control" id="SoDienThoai" data-original="@Model.SoDienThoai" />
                    <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control" id="Email" data-original="@Model.Email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NgayTao" class="form-label fw-semibold"></label>
                    <input asp-for="NgayTao" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Ngày cập nhật</label>
                    <input type="text" class="form-control" value="@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">ID tài khoản liên kết</label>
                    <input type="text" class="form-control" value="@Model.ID_TK" readonly />
                </div>

                @if (Model.TaiKhoan != null)
                {
                    <div class="mb-3">
                        <label asp-for="TaiKhoan.TrangThai" class="form-label fw-semibold"></label>
                        <select asp-for="TaiKhoan.TrangThai" class="form-select" id="TrangThai" data-original="@Model.TaiKhoan.TrangThai">
                            <option value="1">Hoạt động</option>
                            <option value="0">Dừng hoạt động</option>
                        </select>
                        <span asp-validation-for="TaiKhoan.TrangThai" class="text-danger small"></span>
                    </div>
                }

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                    <button type="submit" id="btnLuu" class="btn btn-primary" disabled>
                        <i class="bi bi-save me-1"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        const form = document.getElementById("editForm");
        const btnLuu = document.getElementById("btnLuu");
        const inputs = [
            document.getElementById("HoTen"),
            document.getElementById("SoDienThoai"),
            document.getElementById("Email"),
            document.getElementById("TrangThai")
        ].filter(i => i !== null); // tránh lỗi nếu TrangThai không có

        function checkChanged() {
            let changed = false;
            for (const input of inputs) {
                if (input.value !== input.dataset.original) {
                    changed = true;
                    break;
                }
            }

            btnLuu.disabled = !(changed && form.checkValidity());
        }

        inputs.forEach(input => {
            input.addEventListener("input", checkChanged);
            input.addEventListener("change", checkChanged);
        });

        // Lần đầu kiểm tra nếu có thay đổi
        checkChanged();
    </script>
}
