@model PerfumeShop.Models.NguoiDung

@{
    ViewData["Title"] = "Tạo người dùng mới";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-person-plus-fill me-2"></i> Thêm người dùng</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label for="HoTen" class="form-label fw-semibold">Họ Tên</label>
                    <input asp-for="HoTen" class="form-control" placeholder="Nhập họ tên..." />
                    <span asp-validation-for="HoTen" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label for="SoDienThoai" class="form-label fw-semibold">Số điện thoại</label>
                    <input asp-for="SoDienThoai" class="form-control"
                           data-val="true"
                           data-val-remote="Số điện thoại đã tồn tại"
                           data-val-remote-url="/NhanVien/IsPhoneAvailable"
                           data-val-remote-additionalfields="*.SoDienThoai"
                           placeholder="Nhập số điện thoại..." />
                    <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label for="Email" class="form-label fw-semibold">Email</label>
                    <input asp-for="Email" class="form-control"
                           data-val="true"
                           data-val-remote="Email đã tồn tại"
                           data-val-remote-url="/NhanVien/IsEmailAvailable"
                           data-val-remote-additionalfields="*.Email"
                           placeholder="Nhập email..." />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                @* Trường ẩn ID_TK *@
                <div class="mb-3 d-none">
                    <label class="form-label">Tài khoản liên kết</label>
                    <select asp-for="ID_TK" class="form-control" asp-items="ViewBag.ID_TK"></select>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-success" id="btnSubmit">
                        <i class="bi bi-check-circle me-1"></i> Tạo mới
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            const form = $('form');
            const submitBtn = $('#btnSubmit');

            function toggleSubmit() {
                submitBtn.prop('disabled', !form.valid());
            }

            form.on('input change', 'input', function () {
                setTimeout(toggleSubmit, 300);
            });

            toggleSubmit();
        });
    </script>
}