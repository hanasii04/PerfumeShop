@{
    ViewData["Title"] = "Thêm sản phẩm mới";
}

<h2 class="mb-4 text-center text-primary">Thêm sản phẩm mới</h2>

<form action="/Products/Create" method="post" enctype="multipart/form-data">
    <!-- Thông tin chung -->
    <div class="card mb-4 shadow rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4">
            Thông tin chung
        </div>
        <div class="card-body row g-3">

            <div class="col-md-6">
                <label class="form-label">Tên sản phẩm</label>
                <input name="tenSanPham" class="form-control" value="@ViewBag.TenSanPham" />
                <div class="text-danger">@ViewBag.ErrorTenSanPham</div>
            </div>

            <div class="col-md-6">
                <label class="form-label">Thương hiệu</label>
                <input name="thuongHieu" class="form-control" value="@ViewBag.ThuongHieu" />
                <div class="text-danger">@ViewBag.ErrorThuongHieu</div>
            </div>

            <div class="col-md-6">
                <label class="form-label">Quốc gia</label>
                <input name="quocGia" class="form-control" value="@ViewBag.QuocGia" />
                <div class="text-danger">@ViewBag.ErrorQuocGia</div>
            </div>

            <div class="col-md-6">
                <label class="form-label">Giới tính</label>
                <select name="gioiTinh" class="form-select">
                    <option value="">-- Chọn giới tính --</option>
                    @foreach (var item in ViewBag.GioiTinhList)
                    {
                        <option value="@item.Value" selected="@(item.Value == ViewBag.GioiTinh?.ToString())">@item.Text</option>
                    }
                </select>
                <div class="text-danger">@ViewBag.ErrorGioiTinh</div>
            </div>

            <div class="col-md-6">
                <label class="form-label">Thời gian lưu hương (giờ)</label>
                <input name="thoiGianLuuHuong" type="number" class="form-control" value="@ViewBag.ThoiGianLuuHuong" />
                <div class="text-danger">@ViewBag.ErrorThoiGianLuuHuong</div>
            </div>

            <div class="col-md-6">
                <label class="form-label">Hình ảnh</label>
                <input name="hinhAnh" type="file" class="form-control" />
                <div class="text-danger">@ViewBag.ErrorHinhAnh</div>
            </div>

            <div class="col-md-12">
                <label class="form-label">Mô tả</label>
                <textarea name="moTa" class="form-control" rows="3">@ViewBag.MoTa</textarea>
                <div class="text-danger">@ViewBag.ErrorMoTa</div>
            </div>
        </div>
    </div>

   <!-- Thông tin chi tiết -->
<div class="card mb-4 shadow-lg rounded-4">
    <div class="card-header bg-secondary text-white rounded-top-4">
        Thông tin chi tiết
    </div>
    <div class="card-body row g-4">

        <div class="col-md-6">
            <label class="form-label">Số lượng</label>
            <input name="soLuong" type="number" class="form-control" value="@ViewBag.SoLuong" />
            <div class="text-danger">@ViewBag.ErrorSoLuong</div>
        </div>

        <div class="col-md-6">
            <label class="form-label">Giá nhập (VNĐ)</label>
            <input name="giaNhap" type="number" class="form-control" value="@ViewBag.GiaNhap" />
            <div class="text-danger">@ViewBag.ErrorGiaNhap</div>
        </div>

        <div class="col-md-6">
            <label class="form-label">Thể tích</label>
            <select name="idTheTich" class="form-select">
                <option value="">-- Chọn --</option>
                @foreach (var item in ViewBag.TheTichList)
                {
                    <option value="@item.Value" selected="@(item.Value == ViewBag.IdTheTich?.ToString())">@item.Text</option>
                }
            </select>
            <div class="text-danger">@ViewBag.ErrorIdTheTich</div>
        </div>

        <div class="col-md-6">
            <label class="form-label">Giá bán (VNĐ)</label>
            <input name="giaBan" type="number" class="form-control" value="@ViewBag.GiaBan" />
            <div class="text-danger">@ViewBag.ErrorGiaBan</div>
        </div>

    </div>
</div>


    <div class="d-flex justify-content-between">
        <a href="/Products/Index" class="btn btn-outline-secondary rounded-pill px-4">← Quay lại</a>
        <button type="submit" class="btn btn-success rounded-pill px-4">Thêm sản phẩm</button>
    </div>
</form>

@section Scripts {
    <script>
        $('form').removeData("validator");
        $('form').removeData("unobtrusiveValidation");
    </script>
}
