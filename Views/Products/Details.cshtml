@model PerfumeShop.Models.SanPham

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<h2 class="mb-4">@Model.TenSanPham</h2>

<div class="card mb-4 shadow-sm rounded-4 p-4">
    <div class="row align-items-center">
        <!-- Hình ảnh bên trái -->
        <div class="col-md-4 text-center">
            <img src="@Model.HinhAnh" class="img-thumbnail rounded-3 shadow-sm"
                 style="max-width: 250px; height: auto;" alt="Ảnh sản phẩm" />
        </div>

        <!-- Thông tin bên phải -->
        <div class="col-md-8 fs-5">
            <p><strong>Thương hiệu:</strong> @Model.ThuongHieu</p>
            <p><strong>Quốc gia:</strong> @Model.QuocGia</p>
            <p><strong>Giới tính:</strong> @Model.GioiTinh</p>
            <p><strong>Thời gian lưu hương:</strong> @Model.ThoiGianLuuHuong giờ</p>
            <p><strong>Mô tả:</strong> @Model.MoTa</p>
        </div>
    </div>
</div>

<h4 class="mt-5 mb-3">Các biến thể</h4>

@if (Model.SanPhamChiTiets != null && Model.SanPhamChiTiets.Any())
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover text-center align-middle">
            <thead class="table-light">
                <tr>
                    <th>Thể tích</th>
                    <th>Giá nhập</th>
                    <th>Giá bán</th>
                    <th>Số lượng</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ct in Model.SanPhamChiTiets)
                {
                    <tr>
                        <td>@ct.TheTich?.Ten</td>
                        <td>@ct.GiaNhap.ToString("N0") VNĐ</td>
                        <td>@ct.GiaBan.ToString("N0") VNĐ</td>
                        <td>@ct.SoLuong</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p class="text-muted">Sản phẩm chưa có biến thể nào.</p>
}

<div class="mt-4">
    <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning btn-lg px-4 rounded-3">
        <i class="bi bi-pencil-square"></i> Chỉnh sửa sản phẩm
    </a>
</div>
